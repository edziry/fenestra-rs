format 3;
view panel {
  column root {
    width: 320;
    height: 192;
    padding: 16;
    gap: 12;
    background: rgba8(18, 24, 36, 255);
    row cards {
      width: 288;
      height: 64;
      gap: 12;
      rect primary {
        background: rgba8(48, 128, 192, 255);
        input: accept;
      }
      rect secondary {
        width: 96;
        height: 64;
        background: rgba8(88, 168, 112, 255);
        input: accept;
      }
    }
    rect footer {
      width: 288;
      height: 32;
      background: rgba8(36, 48, 64, 255);
    }
  }
}
